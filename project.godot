; Engine configuration file.
; Metropolis — a real-world task tracker skinned as an isometric city-builder.

config_version=5

[application]

config/name="Metropolis"
config/description="A real-world task/project tracker disguised as a pixel-art isometric city-builder. The task tracker is the engine; the city is the reward."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/show_image=false
config/quit_on_go_back=true

[autoload]

SaveManager="*res://scripts/data/save_manager.gd"
GameState="*res://scripts/data/game_state.gd"

[input_devices]

pointing/emulate_mouse_from_touch=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_2d=0
